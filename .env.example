# Pin High UAE — environment
#
# Copy to .env.local for development. Nothing here is required to run the app
# locally: the catalogue, the importer and the quote flow all work with an
# empty file. What each missing key costs you is noted below, and the admin
# panel shows the same information on the Recipients screen.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3400

# ---------------------------------------------------------------------------
# Admin sign-in
# ---------------------------------------------------------------------------
# The current implementation is a single shared account. It is NOT what spec §2
# requires (invite-only Supabase Auth with MFA) and must be replaced before
# cutover — see README, "Before cutover".
#
# Without these, nobody can sign in to /admin at all.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# 32+ characters. If unset, a random secret is generated per boot, which means
# every restart signs the owner out.
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Supabase (spec §2) — database and file storage
# ---------------------------------------------------------------------------
# Without these three the app still runs end to end on an embedded, in-memory
# database that reseeds per process — fine for development, useless for real
# data. With them, everything persists: catalogue, stock, quotes, uploaded
# images (public bucket) and customer artwork (private bucket).
#
# DATABASE_URL: Supabase → Connect → "Transaction pooler" URI (port 6543),
# with the database password filled in.
DATABASE_URL=
# Settings → API → Project URL
SUPABASE_URL=
# Settings → API → service_role key. Server-side only. Never expose this to
# the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Email — Resend (spec §7.3)
# ---------------------------------------------------------------------------
# Email is the system of record for quote requests. Without ONE of the two
# transports below, requests are still saved and visible in the admin panel,
# but nobody is emailed — recipients show as "skipped" rather than "failed".
#
# Transport 1 — Gmail SMTP. No domain needed; works today. Use a dedicated
# Gmail account, enable 2-Step Verification, then create an App Password
# (Google Account → Security → 2-Step Verification → App passwords).
GMAIL_USER=
GMAIL_APP_PASSWORD=
#
# Transport 2 — Resend, once the sending domain is verified. If both are
# configured, Resend wins.
RESEND_API_KEY=
# Must be on a domain verified in Resend, or delivery silently fails.
ORDER_FROM_EMAIL=quotes@pinhighuae.com

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (spec §7.3)
# ---------------------------------------------------------------------------
# Requires, before any of this works:
#   1. A verified Meta Business account.
#   2. A WhatsApp Business Account with a dedicated sender number — NOT a
#      number already registered on the consumer WhatsApp app.
#   3. An approved message template under the **utility** category, not
#      marketing. Category sets the rate; utility is roughly an order of
#      magnitude cheaper for the same message.
#   4. Each staff recipient opted in to messages from the business number.
#
# Template body (no newlines or tabs in the parameters, or Meta rejects it):
#   New quote request {{1}} from {{2}}. {{3}} units across {{4}} lines.
#   Indicative value AED {{5}}. Branding: {{6}}. Needed by {{7}}.
# Plus one URL button whose parameter is the quote id.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Long-lived system user token, not a temporary one from the dashboard.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ---------------------------------------------------------------------------
# Rate limiting — Upstash Redis (spec §2)
# ---------------------------------------------------------------------------
# Without these the limiter falls back to per-process memory, which protects a
# single instance but not a serverless deployment with several. Set them before
# going live on Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Cloudflare Turnstile (spec §7.2)
# ---------------------------------------------------------------------------
# If TURNSTILE_SECRET_KEY is unset, the check is skipped entirely rather than
# failing every submission. The honeypot and the rate limit still apply.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# Error tracking (spec §11)
# ---------------------------------------------------------------------------
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Local storage paths
# ---------------------------------------------------------------------------
# Where the SQLite database, stock uploads and customer artwork live.
# Defaults to ./.data — which .gitignore excludes, and must stay excluded.
# PINHIGH_DATA_DIR=

# Overrides the file the catalogue is seeded from on first run.
# PINHIGH_SEED_FILE=
